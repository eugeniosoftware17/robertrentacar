# Copiar a public/.htaccess (document root = carpeta public/ tras collectstatic)
# Ajusta las rutas absolutas a tu servidor (cPanel: File Manager → ruta completa del proyecto).

PassengerEnabled On
PassengerAppRoot /home/USUARIO/robertrentacar
PassengerBaseURI /
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py

# Subidas grandes (videos de entrega, hasta 100 MB en Django)
LimitRequestBody 104857600

# --- MEDIA (/static/media/) ---
# MEDIA_URL = '/static/media/' y MEDIA_ROOT = STATIC_ROOT/'media' (public/media/)
# a proposito: WhiteNoise (dentro de la app Django, ver settings.py) ya sirve
# todo /static/ correctamente, ANTES de LoginRequiredMiddleware — asi que
# /static/media/** se sirve por el mismo camino probado, sin symlinks ni
# contextos especiales de LiteSpeed. No hace falta configurar nada extra aqui
# para media: cae a Passenger igual que cualquier /static/, y WhiteNoise lo
# resuelve (con WHITENOISE_AUTOREFRESH=True para que los uploads nuevos no
# necesiten reiniciar Passenger).
#
# IMPORTANTE: <Location>/<LocationMatch> con "PassengerEnabled off" NO es valido
# dentro de .htaccess (solo en contexto de vhost/servidor) — Apache y LiteSpeed
# lo ignoran silenciosamente. NO usar ese patron aqui.
#
# La regla de abajo es igual util de todos modos: evita que Passenger reprocese
# cualquier archivo que YA existe en disco bajo public/ (assets con hash de
# collectstatic, etc.), sirviendolo directo sin pasar por la app:
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>
